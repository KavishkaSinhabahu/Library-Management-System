	<parameter name="Parameter1" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT libms.book_stock.stock_id,
	libms.book_stock.bookname,
	libms.book_stock.qty,
	libms.book_category.category_name
FROM libms.book_stock
	INNER JOIN libms.book_category ON 
	 libms.book_stock.category = libms.book_category.cat_id]]>
	</queryString>
