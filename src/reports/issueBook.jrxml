	<queryString>
		<![CDATA[SELECT libms.issue_book.is_id,
	libms.issue_book.issue_date,
	libms.student.fname,
	libms.student.lname,
	libms.books.book_name,
	libms.issue_book.due_date
FROM libms.issue_book
	INNER JOIN libms.books ON 
	 libms.issue_book.books_b_id = libms.books.b_id 
	INNER JOIN libms.student ON 
	 libms.student.ac_id = libms.issue_book.student_ac_id WHERE libms.issue_book.`status` = '1']]>
	</queryString>
