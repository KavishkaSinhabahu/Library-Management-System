	<queryString>
		<![CDATA[SELECT libms.books.book_id,
	libms.student.`uniquiID`,
	libms.due_payments.charge_per_day,
	libms.due_payments.due_dates,
	libms.due_payments.payment_date
FROM libms.due_payments
	INNER JOIN libms.student ON 
	 libms.due_payments.student_id = libms.student.ac_id 
	INNER JOIN libms.books ON 
	 libms.due_payments.book_id = libms.books.b_id]]>
	</queryString>
