	<parameter name="Parameter1" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT libms.removebooks.re_id,
	libms.books.book_name,
	libms.books.book_id,
	libms.bookremove_reason.reason
FROM libms.removebooks
	INNER JOIN libms.bookremove_reason ON 
	 libms.removebooks.reason_id = libms.bookremove_reason.r_id 
	INNER JOIN libms.books ON 
	 libms.removebooks.book_id = libms.books.b_id]]>
	</queryString>
