	<parameter name="Parameter1" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT libms.student.ac_id,
	libms.student.fname,
	libms.student.lname,
	libms.student.mobile,
	libms.student.`uniquiID`,
	libms.student.addressline1,
	libms.student.addressline2,
	libms.student.registered_date,
	libms.city.city_name
FROM libms.student
	INNER JOIN libms.city ON 
	 libms.student.city_ci_id = libms.city.ci_id]]>
	</queryString>
